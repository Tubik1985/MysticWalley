<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MysticWalley.Views.HistoryPage"
             Title="История предсказаний">

    <Grid RowDefinitions="Auto,*">

        <!-- Кнопка очистки -->
        <Button Text="🗑 Очистить историю"
                BackgroundColor="DarkRed"
                TextColor="White"
                Clicked="OnClearHistoryClicked"
                Margin="10"
                HorizontalOptions="Center"
                Grid.Row="0"/>

        <!-- Список сохранённых предсказаний -->
        <CollectionView x:Name="HistoryView"
                        Margin="10"
                        Grid.Row="1">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="Purple"
                           Margin="4"
                           Padding="8"
                           CornerRadius="8">

                        <VerticalStackLayout>
                            <!-- Имя героя -->
                            <Label Text="{Binding Hero}"
                                   FontAttributes="Bold"
                                   TextColor="Purple" />

                            <!-- Текст предсказания -->
                            <Label Text="{Binding Text}"
                                   TextColor="Black"
                                   LineBreakMode="WordWrap"/>

                            <!-- Время записи -->
                            <Label Text="{Binding Time, StringFormat='{0:G}'}"
                                   FontSize="10"
                                   TextColor="Gray" />
                        </VerticalStackLayout>

                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
</ContentPage>