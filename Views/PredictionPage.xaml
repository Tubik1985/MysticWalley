<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MysticWalley.Views.PredictionPage"
             BackgroundColor="Black">

    <Grid>
        <Image x:Name="BackgroundImage" Aspect="AspectFill" Opacity="0" />

        <ScrollView>
            <VerticalStackLayout Margin="20,40" Spacing="24" HorizontalOptions="Center">

                <Image x:Name="CharacterIcon" WidthRequest="220" HeightRequest="220" Aspect="AspectFit" HorizontalOptions="Center" />
                <Label x:Name="CharacterLabel" FontSize="26" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Label x:Name="CharacterDescription" FontSize="15" TextColor="#EAEAEA" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                <Button x:Name="PredictButton" Text="🔮 Получить предсказание" Clicked="OnPredictClicked" BackgroundColor="#6A0DAD" TextColor="White" CornerRadius="18" Padding="14,8" HorizontalOptions="Center" />

                <!-- Блок личного предсказания -->
                <Frame x:Name="AiFrame" Padding="14" BackgroundColor="#80202040" CornerRadius="14" HasShadow="False" Opacity="0" HorizontalOptions="Center" WidthRequest="290" TranslationY="50">
                    <Label x:Name="AiLabel" FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                </Frame>

                <!-- ==================================================================== -->
                <!-- ИЗМЕНЕНИЕ: Теперь это пустой контейнер для динамических сцен -->
                <!-- ==================================================================== -->
                <VerticalStackLayout x:Name="SceneContainer" Spacing="10" HorizontalOptions="Center" WidthRequest="290" />

                <!-- Отладочная панель -->
                <Frame BorderColor="DarkRed" BackgroundColor="#330000" Padding="10" Margin="0,20,0,0" HorizontalOptions="Center" WidthRequest="290">
                    <VerticalStackLayout>
                        <Label Text="--- DEBUG INFO ---" TextColor="Red" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label x:Name="DebugEpisodeLabel" TextColor="OrangeRed" FontSize="12" HorizontalTextAlignment="Center" Text="Текущий эпизод: (ожидание)" />
                        <Label x:Name="DebugMoodsLabel" TextColor="OrangeRed" FontSize="12" HorizontalTextAlignment="Center" Text="Настроения: (ожидание)" />
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>