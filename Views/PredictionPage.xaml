<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MysticWalley.Views.PredictionPage"
             BackgroundColor="Black">

    <Grid>
        <!-- Фон -->
        <Image x:Name="BackgroundImage"
               Aspect="AspectFill"
               Opacity="0" />

        <ScrollView>
            <VerticalStackLayout Margin="20,40"
                                 Spacing="24"
                                 HorizontalOptions="Center">

                <!-- Портрет -->
                <Image x:Name="CharacterIcon"
                       WidthRequest="220"
                       HeightRequest="220"
                       Aspect="AspectFit"
                       HorizontalOptions="Center" />

                <!-- Имя -->
                <Label x:Name="CharacterLabel"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <!-- Описание -->
                <Label x:Name="CharacterDescription"
                       FontSize="15"
                       TextColor="#EAEAEA"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />

                <!-- Кнопка вызова -->
                <Button x:Name="PredictButton"
                        Text="🔮 Получить предсказание"
                        Clicked="OnPredictClicked"
                        BackgroundColor="#6A0DAD"
                        TextColor="White"
                        CornerRadius="18"
                        Padding="14,8"
                        HorizontalOptions="Center" />

                <!-- Блок живого предсказания -->
                <Frame x:Name="AiFrame"
                       Padding="14"
                       BackgroundColor="#80202040"
                       CornerRadius="14"
                       HasShadow="False"
                       Opacity="0"
                       HorizontalOptions="Center"
                       WidthRequest="290">
                    <Label x:Name="AiLabel"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />
                </Frame>

                <!-- Блок сюжетных реплик -->
                <Frame x:Name="SceneFrame"
                       Padding="14"
                       BackgroundColor="#80202020"
                       CornerRadius="14"
                       HasShadow="False"
                       Opacity="0"
                       HorizontalOptions="Center"
                       WidthRequest="290">
                    <Label x:Name="SceneLabel"
                           FontSize="16"
                           TextColor="#EAEAEA"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>