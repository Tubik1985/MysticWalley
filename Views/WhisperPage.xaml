<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MysticWalley.Views.WhisperPage"
             
             xmlns:viewmodels="clr-namespace:MysticWalley.ViewModels"
             xmlns:models="clr-namespace:MysticWalley.Services"
             x:DataType="viewmodels:WhisperViewModel"
             
             BackgroundColor="Black"
             Title="Шёпот долины">

    <Grid RowDefinitions="*, Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Margin="16,12" Spacing="12">
                <Label Text="🕯 Архив шёпотов"
                       FontAttributes="Bold"
                       FontSize="22"
                       TextColor="White"
                       HorizontalOptions="Center" />

                <CollectionView ItemsSource="{Binding WhisperEntries}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:WhisperEntry">
                            <Frame Margin="0,6" Padding="12" BackgroundColor="#202020" BorderColor="#3A3A3A" CornerRadius="10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Hero}" FontAttributes="Bold" FontSize="16" TextColor="#AE81FF" />
                                    <Label Text="{Binding Emotion}" FontSize="12" TextColor="#7EB6FF">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Emotion, Converter={StaticResource StringNotNullOrEmptyConverter}}" Value="False">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding Text}" TextColor="White" FontSize="14" LineBreakMode="WordWrap" />
                                    <Label Text="{Binding Time, StringFormat='{0:G}'}" FontSize="11" TextColor="#AAAAAA" HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ============================================================= -->
        <!-- ИЗМЕНЕНИЕ: Убрали Command, добавили x:Name и Clicked-событие -->
        <!-- ============================================================= -->
        <Button Grid.Row="1"
                x:Name="ClearWhispersButton"
                Text="🗑 Очистить шёпоты долины"
                Clicked="ClearWhispersButton_Clicked"
                BackgroundColor="DarkRed"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="8"
                HeightRequest="44"
                HorizontalOptions="Center"
                Margin="0,12,0,24" />
    </Grid>
</ContentPage>