<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MysticWalley.Views.WhisperPage"
             BackgroundColor="Black"
             Title="Шёпот долины">

    <ScrollView>
        <VerticalStackLayout Margin="16,12" Spacing="12">

            <!-- Заголовок страницы -->
            <Label Text="🕯 Архив шёпотов"
                   FontAttributes="Bold"
                   FontSize="22"
                   TextColor="White"
                   HorizontalOptions="Center" />

            <!-- Список шёпотов -->
            <CollectionView x:Name="WhisperList">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,6"
                               Padding="12"
                               BackgroundColor="#202020"
                               BorderColor="#3A3A3A"
                               CornerRadius="10">

                            <VerticalStackLayout Spacing="4">

                                <!-- Имя героя -->
                                <Label Text="{Binding Hero}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="#AE81FF" />

                                <!-- Эмоция -->
                                <Label Text="{Binding Emotion}"
                                       FontSize="12"
                                       TextColor="#7EB6FF"
                                       IsVisible="{Binding Emotion, Converter={StaticResource StringNotNullOrEmptyConverter}}" />

                                <!-- Основной текст -->
                                <Label Text="{Binding Text}"
                                       TextColor="White"
                                       FontSize="14"
                                       LineBreakMode="WordWrap" />

                                <!-- Время добавления -->
                                <Label Text="{Binding Time, StringFormat='{0:G}'}"
                                       FontSize="11"
                                       TextColor="#AAAAAA"
                                       HorizontalOptions="End" />
                            </VerticalStackLayout>

                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- 🧹 Кнопка очистки архива -->
            <Button Text="🗑 Очистить шёпоты долины"
                    Clicked="OnClearWhispersClicked"
                    BackgroundColor="DarkRed"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="44"
                    HorizontalOptions="Center"
                    Margin="0,12,0,24" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>