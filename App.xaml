<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MysticWalley"
             xmlns:conv="clr-namespace:MysticWalley.Converters"
             x:Class="MysticWalley.App">

    <Application.Resources>
        <ResourceDictionary>
            <!-- Подключаем внутренние словари стилей -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 🪄 Конвертеры и глобальные ресурсы -->
            <conv:StringNotNullOrEmptyConverter x:Key="StringNotNullOrEmptyConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>